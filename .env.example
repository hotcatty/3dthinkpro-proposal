# 已确认：hiqd7j-pw.myshopify.com（与 aem02u-zy.myshopify.com 同一店）
# 不要加 https://
SHOPIFY_STORE_DOMAIN=hiqd7j-pw.myshopify.com

# Storefront API public access token
# Header：X-Shopify-Storefront-Access-Token
# 服务端代理时必须再带 Shopify-Storefront-Buyer-IP（代码已处理）。
#
# 当前查询（商品 / 购物车）落在 Tokenless 范围内，不填也能跑。
# 一旦用 Product Tags / Metafields / Menu / Customers，就必须填，并勾对应 scope。
#
# 从 Headless channel → Storefront API 复制 Public access token。
# 不要把 Admin token（shpat_）或 Storefront Private token 写到这个变量里。
# Private token 的 header 是 Shopify-Storefront-Private-Token，换值不改代码会 401。
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# 运营后台 /admin 密码，不要提交真实值
CMS_ADMIN_PASSWORD=

# Admin API 凭据 —— 服务端专用，绝不能出现在前端或浏览器
# 用途：运营后台直接把商品推到 Shopify，不用手工传 CSV
# Header：X-Shopify-Access-Token（注意不是 Storefront 那套 header）
# 需要的权限：read_products / write_products / read_files / write_files / read_publications / write_publications
#
# 2026 起 Shopify 不再在店铺后台 Reveal access token。新流程：
#   1. 打开 https://dev.shopify.com/dashboard → Apps → Create app
#   2. 在 Versions 里勾 read_products / write_products / read_files / write_files / read_publications / write_publications 然后 Release
#   3. 在 Settings 里拿 Client ID（32 位 hex）和 Client Secret（shpss_ 开头）
#   4. 把这两个填到下面，dev server 启动时会自动跑 client_credentials 换 24h 有效 token
#   5. 也可以走 OAuth authorization code 自己换永久 token，填到 SHOPIFY_ADMIN_ACCESS_TOKEN
#
# 两套凭据同时存在时，显式 token 优先；否则自动用 Client ID + Secret 换。
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Judge.me — 服务端拉真实评论。Private token 不要写到 NEXT_PUBLIC_
# 后台：Judge.me → Settings → Integrations → View API tokens
JUDGEME_SHOP_DOMAIN=hiqd7j-pw.myshopify.com
JUDGEME_PUBLIC_API_TOKEN=
JUDGEME_PRIVATE_API_TOKEN=

# Vehicle request form → sales inbox
# Prefer Resend; SMTP is the fallback. Do not commit real keys.
CONTACT_INBOX=sales1@3dthinkpro.com
RESEND_API_KEY=
RESEND_FROM=3DThinkPro <noreply@your-verified-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
